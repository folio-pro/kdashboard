{
  "name": "kdashboard",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:electron:main": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "dev:electron": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on tcp:1420 && npm run build:electron:main && cross-env ELECTRON_DEV=1 electron .\"",
    "build:electron": "vite build && npm run build:electron:main && electron-builder",
    "test:js": "bun test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "benchmark": "tsx scripts/run-playwright-benchmarks.ts",
    "benchmark:ci": "tsx scripts/run-playwright-benchmarks.ts ./benchmark-results.json",
    "fetch-pricing": "bun scripts/fetch-pricing.ts",
    "test": "bun test && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@kubernetes/client-node": "^1.4.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/svelte-virtual": "^3.13.26",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "@codemirror/view": "^6.43.0"
  },
  "build": {
    "appId": "com.kdashboard.app",
    "productName": "kdashboard",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    }
  }
}
