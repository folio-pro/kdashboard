{
  "name": "kdashboard",
  "private": true,
  "version": "0.9.1",
  "author": "Nicolás Mengual",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build && electron-builder",
    "preview:electron": "electron-vite preview",
    "test:js": "bun test",
    "test:electron": "bun test ./electron",
    "test:integration": "node --import tsx --test electron/integration/*.itest.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "benchmark": "./scripts/bench/frontend.sh",
    "benchmark:ci": "RUNS=1 LABEL=ci ./scripts/bench/frontend.sh",
    "fetch-pricing": "bun scripts/fetch-pricing.ts",
    "test": "bun test && bun test ./electron"
  },
  "//trustedDependencies": "Bun blocks postinstall scripts unless the package is listed here. Electron's postinstall is what downloads its ~211 MB binary, so without this a `bun install` leaves node_modules/electron with no dist/ and `dev:electron` dies with 'Error: Electron uninstall'. npm and npm ci run postinstall regardless and never needed this. node-pty's postinstall builds its native pty.node via node-gyp, so it is listed too.",
  "trustedDependencies": [
    "electron",
    "node-pty"
  ],
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@kubernetes/client-node": "^1.4.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-virtual": "^3.13.35",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@wterm/dom": "0.3.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^5.2.3",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "undici": "^8.10.0",
    "vite": "^7.3.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.kdashboard.app",
    "productName": "Kdashboard",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "artifactName": "kdashboard-${version}-${arch}.${ext}",
      "identity": null
    },
    "afterPack": "./scripts/sign-adhoc.mjs",
    "publish": {
      "provider": "github",
      "owner": "folio-pro",
      "repo": "kdashboard"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "kdashboard-Setup-${version}.${ext}"
    }
  }
}
